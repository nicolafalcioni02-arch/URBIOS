+        const prof = new Float32Array(h); for (let y = 0; y < h; y++) { let s = 0; for (let x = a; x <= b; x++) s += f[y * w + x]; prof[y] = s / Math.max(1, b - a + 1); }
+        const pr = sm1(prof, Math.max(1, Math.round(h / 400)));
+        const win = Math.max(3, Math.round(h / 45)); const found = [];
+        for (let y = win; y < h - win; y++) {
+            let isMax = true; let mn = pr[y];
+            for (let k = -win; k <= win; k++) { if (pr[y + k] > pr[y]) { isMax = false; break; } }
+            if (!isMax || pr[y] < 0.2) continue;
+            if (pr[y] === pr[y - 1] && found.length && y - found[found.length - 1].yy < win) continue;
+            let l = pr[y]; for (let k = 1; k <= win * 2 && y - k >= 0; k++) l = Math.min(l, pr[y - k]);
+            let rr = pr[y]; for (let k = 1; k <= win * 2 && y + k < h; k++) rr = Math.min(rr, pr[y + k]);
+            if (pr[y] - Math.max(l, rr) < 0.1) continue;
+            found.push({ yy: y, s: pr[y] });
+        }
+        lanes.push({ x0: (sg[0] / w) * 100, x1: (sg[1] / w) * 100, n: found.length });
+        found.forEach((q) => bands.push({ lane: li, y: (q.yy / h) * 100, s: q.s }));
+    });
+    // istogramma chirurgico: l'immagine non si ricrea, si cerca solo la curva dei toni che separa le bande dal fondo.
+    // maschera = pixel di banda (forza > soglia, un poco allargata); fondo = tutto il resto
+    const M = ext(ext(f, w, h, 2, 2, true), w, h, 0, 0, true); const bandV = []; const bgV = [];
+    for (let i = 0; i < Y.length; i++) { if (M[i] > 0.25) bandV.push(Y2[i]); else bgV.push(Y2[i]); }
+    bandV.sort((x, y) => x - y); bgV.sort((x, y) => x - y);
+    const q = (arr, t) => arr[Math.min(arr.length - 1, Math.max(0, Math.floor(t * arr.length)))];
+    let lo = Math.round(q(bgV, 0.9)); let hi = Math.round(q(bandV, 0.995));
+    if (!(hi - lo > 20)) { lo = 0; hi = 255; }
+    // curva: equalizzazione dei soli pixel di banda, mescolata alla retta (così il passaggio resta morbido)
+    const cdf = (v) => { let a = 0; let b = bandV.length; while (a < b) { const m = (a + b) >> 1; if (bandV[m] < v) a = m + 1; else b = m; } return a / Math.max(1, bandV.length); };
+    const c0 = cdf(lo); const c1 = cdf(hi); const pts = []; let prev = -1;
+    for (let k = 0; k <= 10; k++) {
+        const x = Math.round((k * 255) / 10); const v = lo + (x / 255) * (hi - lo);
+        const e = Math.max(0, Math.min(1, (cdf(v) - c0) / Math.max(0.0001, c1 - c0)));
+        // in basso si solleva (bande deboli), in alto si torna a una retta un po' sotto il bianco: niente zone bruciate attorno alle bande forti
+        const tt = Math.max(0, Math.min(1, (x - 90) / 110)); const sm = tt * tt * (3 - 2 * tt);
+        let y = Math.round(255 * ((1 - sm) * (0.55 * e + 0.45 * (x / 255)) + sm * 0.92 * (x / 255)));
+        if (y <= prev + 1 && k > 0 && k < 10) y = prev + 2; prev = y; pts.push([x, Math.min(255, y)]);
+    }
+    pts[0] = [0, 0]; pts[pts.length - 1] = [255, 255];
+    return { lanes, bands, w, h, lo, hi, curve: pts, halo: 100 };
+};
